---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { ExpenseList } from "../../components/ExpenseList";
import type { ExpenseStatus } from "@quickspense/domain";

if (!Astro.locals.user) {
  return Astro.redirect("/login");
}

// Initial status tab is read from `?status=` so deep links from the dashboard
// can land on a specific tab. Defaults to "active" (only confirmed expenses).
const statusParam = Astro.url.searchParams.get("status");
const validStatuses: ExpenseStatus[] = [
  "active",
  "processing",
  "needs_review",
  "failed",
];
const initialStatus: "" | ExpenseStatus =
  statusParam === "" || statusParam === "all"
    ? ""
    : (validStatuses as string[]).includes(statusParam ?? "")
      ? (statusParam as ExpenseStatus)
      : "active";
---

<Layout>
  <PageHeader title="Expenses">
    <a
      href="/expenses/new"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl text-sm font-medium transition-colors duration-200 h-9 px-4 py-2 bg-accent-500 text-white hover:bg-accent-600"
    >
      + New Expense
    </a>
    <a
      href="/expenses/upload"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl text-sm font-medium transition-colors duration-200 h-9 px-4 py-2 border border-white/20 bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white"
    >
      Upload Receipts
    </a>
  </PageHeader>
  <ExpenseList initialStatus={initialStatus} client:load />
</Layout>
