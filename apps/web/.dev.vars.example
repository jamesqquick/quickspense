# Local development secrets. Copy to .dev.vars and fill in.
# .dev.vars is gitignored. Never commit real secrets.

# URL of the locally-running background worker (apps/worker).
# Required for receipt uploads, reprocessing, and any flow that triggers a
# Workflow. The web app uses this URL to reach the worker via plain HTTP
# instead of the Service Binding, because Service Bindings don't reliably
# cross separate `wrangler dev` / `astro dev` processes (they return 503).
# Run `pnpm dev:worker` in a separate terminal; it defaults to port 8787.
WORKER_DEV_URL=http://localhost:8787

# Stripe — required for invoicing.
# Use a TEST-MODE key only. The app refuses to start with `sk_live_...`
# outside production (see lib/stripe.ts). Get from:
#   https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get from `stripe listen --forward-to localhost:4321/api/webhooks/stripe`
# (NOT the same as the production webhook secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional escape hatch: set to "1" to allow `sk_live_...` keys outside
# production. Only use this if you're knowingly reproducing a live-mode
# bug locally. DO NOT leave this set.
# STRIPE_ALLOW_LIVE_KEY=1

# Better Auth — required for all authentication flows.
# Generate a strong random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:4321

# Google OAuth — optional; omit to disable "Sign in with Google".
# Create an OAuth 2.0 Client ID (Web application) in the Google Cloud Console.
# Authorized redirect URIs:
#   Dev:  http://localhost:4321/api/auth/callback/google
#   Prod: https://quickspense.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
